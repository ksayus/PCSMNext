<UserControl x:Class="PCSMNext.App.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PCSMNext.App.Views"
             xmlns:controls="clr-namespace:PCSMNext.App.Controls"
             xmlns:viewmodels="clr-namespace:PCSMNext.App.ViewModels" d:DataContext="{d:DesignInstance Type=viewmodels:SettingsViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Background="Transparent" Foreground="{DynamicResource ColorTextBlack}">
    <Border CornerRadius="0,0,7,0"
            ClipToBounds="True">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="30">
                <!-- 标题 -->
                <TextBlock Text="设置" FontSize="24" FontWeight="Bold"
                   Foreground="#f0a050" Margin="0,0,0,24"/>

                <!-- 主题选择 -->
                <TextBlock Text="主题" FontSize="14" Margin="0,0,0,6"/>
                <ComboBox ItemsSource="{Binding Themes}"
                  SelectedItem="{Binding SelectedTheme, Mode=TwoWay}"
                  Width="200" HorizontalAlignment="Left"
                  Background="{DynamicResource ColorTextMuted}" Foreground="{DynamicResource ColorAccent}"
                  Margin="0,0,0,16"/>

                <!-- 更新源 -->
                <TextBlock Text="更新源" FontSize="14" Margin="0,0,0,6"/>
                <ComboBox ItemsSource="{Binding UpdateSources}"
                  SelectedItem="{Binding SelectedUpdateSources, Mode=TwoWay}"
                  Width="200" HorizontalAlignment="Left"
                  Background="{DynamicResource ColorTextMuted}" Foreground="{DynamicResource ColorAccent}"
                  Margin="0,0,0,16"/>

                <!-- 自动更新 -->
                <CheckBox Content="自动检查更新"
                  IsChecked="{Binding CheckAutoUpdate}"
                  Foreground="{DynamicResource ColorTextBlack}" Margin="0,0,0,16"/>

                <!-- 自动启动 -->
                <CheckBox Content="开机自启动"
                  IsChecked="{Binding CheckStartup}"
                  Foreground="{DynamicResource ColorTextBlack}" Margin="0,0,0,24"/>

                <!-- 操作按钮 -->
                <StackPanel Orientation="Horizontal">
                    <controls:MyIconButton Content="重置" Command="{Binding ResetSettingsCommand}"/>
                </StackPanel>

                <!-- 状态消息 -->
                <TextBlock Text="{Binding StatusMessage}" FontSize="13"
                   Foreground="{DynamicResource ColorTextBlack}" Margin="0,16,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
