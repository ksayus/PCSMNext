<UserControl x:Class="PCSMNext.App.Views.ServerListPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:PCSMNext.Core.Models;assembly=PCSMNext.Core"
             xmlns:controls="clr-namespace:PCSMNext.App.Controls"
             Background="Transparent"
             Foreground="{DynamicResource ColorTextWhite}">

    <Border CornerRadius="0,0,7,0"
            ClipToBounds="True">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 顶部操作栏 -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                
                <controls:MyIconButton Content="刷新列表" Command="{Binding LoadServersCommand}"
                                       IconText="&#xE896;"/>
                <controls:MyIconButton Content="添加服务器"/>
            </StackPanel>

            <!-- 服务器卡片列表 -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Servers}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:ServerInfo}">
                            <Border Background="{DynamicResource ColorBg}"
                            BorderBrush="{DynamicResource ColorBorder}"
                            BorderThickness="1" CornerRadius="8"
                            Padding="20" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 服务器名称和版本 -->
                                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource ColorTextWhite}"/>
                                        <TextBlock Text="{Binding Version, StringFormat=' v{0}'}"
                                           FontSize="14"
                                           Foreground="{DynamicResource ColorTextWhite}"
                                           Margin="10,4,0,0"/>
                                    </StackPanel>

                                    <!-- 详细信息 -->
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBlock Text="{Binding CoreType}" FontSize="13"
                                           Foreground="{DynamicResource ColorTextWhite}"
                                           Margin="0,0,16,0"/>
                                        <TextBlock Text="{Binding JavaVersion, StringFormat='JDK {0}'}"
                                           FontSize="13"
                                           Foreground="{DynamicResource ColorTextWhite}"
                                           Margin="0,0,16,0"/>
                                        <TextBlock Text="{Binding Path}" FontSize="13"
                                           Foreground="{DynamicResource ColorTextWhite}"/>
                                    </StackPanel>

                                    <!-- 统计信息 -->
                                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBlock Text="{Binding Size, StringFormat='存储: {0}MB'}"
                                           FontSize="12"
                                           Foreground="{DynamicResource ColorTextWhite}"
                                           Margin="0,0,16,0"/>
                                        <TextBlock Text="{Binding Counts, StringFormat='启动次数: {0}'}"
                                           FontSize="12"
                                           Foreground="{DynamicResource ColorTextWhite}"/>
                                    </StackPanel>

                                    <!-- 操作按钮 -->
                                    <StackPanel Grid.Column="1" Grid.RowSpan="3"
                                        VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <Button Content="启动" Height="32" Width="72"
                                        Command="{Binding DataContext.StartServerCommand,
                                            RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        Background="{DynamicResource ColorAccent2}"
                                        Foreground="{DynamicResource ColorTextWhite}"
                                        BorderThickness="0" FontWeight="Bold" Margin="0,0,0,6"/>
                                        <Button Content="删除" Height="28" Width="72"
                                        Command="{Binding DataContext.DeleteServerCommand,
                                            RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        Background="#3a2030" Foreground="#e05050"
                                        BorderThickness="0" FontSize="12"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 底部状态栏 -->
            <Border Grid.Row="2" Background="{DynamicResource ColorTextMuted}"
            CornerRadius="4" Padding="10,6" Margin="0,12,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding StatusMessage}"
                       Foreground="{DynamicResource ColorTextWhite}" FontSize="13"/>
                    <TextBlock Text="PCSM Next"
                       Foreground="{DynamicResource ColorTextWhite}" FontSize="13"
                       HorizontalAlignment="Right" Margin="20,0,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>