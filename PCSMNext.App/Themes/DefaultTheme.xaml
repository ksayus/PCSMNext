<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 基础色 -->

    <SolidColorBrush x:Key="ColorBg"         Color="#e2e8f0"/>
    <!-- 页面背景 -->
    <SolidColorBrush x:Key="ColorSidebar"    Color="#ffffff"/>
    <!-- 侧边栏背景 -->
    <SolidColorBrush x:Key="ColorSurface"    Color="#7f8ea3"/>
    <!-- 卡片表面 -->
    <SolidColorBrush x:Key="ColorBorder"     Color="#1370f3"/>
    <!-- 分割线/边框 -->

    <!-- 通知栏 -->
    <SolidColorBrush x:Key="ColorHint" Color="#4492ff"/>

    <!-- === 文字层级 === -->
    <SolidColorBrush x:Key="ColorTextWhite"       Color="#f7faff"/>
    <SolidColorBrush x:Key="ColorTextBlue"   Color="#1A76D2"/>
    <SolidColorBrush x:Key="ColorTextBlack"  Color="#111111"/>
    <SolidColorBrush x:Key="ColorTextTitle"  Color="#ffffff"/>
    <!-- 正文/标题 -->
    <SolidColorBrush x:Key="ColorTextMuted"  Color="#64748b"/>
    <!-- 次要文字 -->

    <!-- === 强调色系统：琥珀 + 青 === -->
    <SolidColorBrush x:Key="ColorAccent"        Color="#f0a050"/>
    <SolidColorBrush x:Key="ColorAccentHover"   Color="#f5b870"/>
    <SolidColorBrush x:Key="ColorAccentPressed" Color="#e09040"/>
    <SolidColorBrush x:Key="ColorAccent2"       Color="#5eead4"/>

    <!-- === 状态色 === -->
    <SolidColorBrush x:Key="ColorSuccess"  Color="#22c55e"/>
    <SolidColorBrush x:Key="ColorDanger"   Color="#ef4444"/>
    <SolidColorBrush x:Key="ColorWarning"  Color="#eab308"/>
    
    <!-- 按钮: 背景 -->
    <SolidColorBrush x:Key="ColorButtonBg1" Color="#4f9bff"/>

    <!-- 按钮: 悬停 -->
    <SolidColorBrush x:Key="ColorButtonOver1" Color="#3d91ff"/>

    <!-- 按钮: 按下 -->
    <SolidColorBrush x:Key="ColorButtonPressed1" Color="#3381e8"/>

    <!-- 按钮: 按下 -->
    <SolidColorBrush x:Key="ColorButtonEnabled1" Color="#f2f7ff"/>

    <!-- 导航栏选中/悬停背景 === -->
    <SolidColorBrush x:Key="ColorNavActiveBg" Color="#62a0f7"/>
    <SolidColorBrush x:Key="ColorNavHoverBg"  Color="#f2f7ff"/>


        <!-- 按钮样式引用语义色 -->
    <Style TargetType="Button" x:Key="NavButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorTextBlack}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Height" Value="44"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Padding" Value="20,0,0,0"/>
        <Setter Property="BorderThickness" Value="0,0,3,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource ColorNavHoverBg}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="Button" x:Key="ActiveNavButton" BasedOn="{StaticResource NavButton}">
        <Setter Property="Background" Value="{DynamicResource ColorNavActiveBg}"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorBg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColorBorder}"/>
    </Style>
</ResourceDictionary>