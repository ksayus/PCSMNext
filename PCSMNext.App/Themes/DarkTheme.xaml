<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- ===== 基础色 ===== -->
    <SolidColorBrush x:Key="ColorBg" Color="#0b1219"/>
    <!-- 深邃蓝黑 -->
    <SolidColorBrush x:Key="ColorSidebar" Color="#131e2a"/>
    <!-- 侧栏略浅 -->
    <SolidColorBrush x:Key="ColorSurface" Color="#1a2736"/>
    <!-- 卡片表面 -->
    <SolidColorBrush x:Key="ColorBorder" Color="#2a3a4e"/>
    <!-- 边框 -->

    <!-- ===== 文字层级 ===== -->
    <SolidColorBrush x:Key="ColorTextWhite" Color="#f0f4fa"/>
    <SolidColorBrush x:Key="ColorTextBlack" Color="#11181f"/>
    <SolidColorBrush x:Key="ColorTextTitle" Color="#e6edf5"/>
    <SolidColorBrush x:Key="ColorTextMuted" Color="#7b8ba3"/>

    <!-- ===== 强调色系统 ===== -->
    <SolidColorBrush x:Key="ColorAccent" Color="#f0a050"/>
    <SolidColorBrush x:Key="ColorAccentHover" Color="#f5b870"/>
    <SolidColorBrush x:Key="ColorAccentPressed" Color="#d98e3a"/>
    <SolidColorBrush x:Key="ColorAccent2" Color="#5eead4"/>

    <!-- ===== 状态色 ===== -->
    <SolidColorBrush x:Key="ColorSuccess" Color="#22c55e"/>
    <SolidColorBrush x:Key="ColorDanger" Color="#ef4444"/>
    <SolidColorBrush x:Key="ColorWarning" Color="#eab308"/>

    <!-- ===== 导航栏状态 ===== -->
    <SolidColorBrush x:Key="ColorNavActiveBg" Color="#3b6cb7"/>
    <SolidColorBrush x:Key="ColorNavHoverBg" Color="#1f2e42"/>

    <!-- ===== 按钮样式 ===== -->
    <!-- 普通导航按钮 -->
    <Style TargetType="Button" x:Key="NavButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorTextTitle}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Height" Value="44"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Padding" Value="20,0,0,0"/>
        <Setter Property="BorderThickness" Value="0,0,3,0"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource ColorNavHoverBg}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 选中状态导航按钮 -->
    <Style TargetType="Button" x:Key="ActiveNavButton" BasedOn="{StaticResource NavButton}">
        <Setter Property="Background" Value="{DynamicResource ColorNavActiveBg}"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorTextWhite}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColorBorder}"/>
        <Setter Property="BorderThickness" Value="0,0,3,0"/>
    </Style>

    <!-- 主要按钮（原PrimaryButton保持不变） -->
    <Style TargetType="Button" x:Key="PrimaryButton">
        <Setter Property="Background" Value="{StaticResource ColorAccent}"/>
        <Setter Property="Foreground" Value="{StaticResource ColorTextBlack}"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
</ResourceDictionary>