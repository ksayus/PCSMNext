<Window x:Class="PCSMNext.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:PCSMNext.App.Views"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="PCSM Next" Height="500" Width="864"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResize"
        Background="Transparent"
        Foreground="{DynamicResource ColorTextWhite}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome GlassFrameThickness="0"
                            ResizeBorderThickness="5"
                            CaptionHeight="0"
                            UseAeroCaptionButtons="False"
                            CornerRadius="5"/>
    </shell:WindowChrome.WindowChrome>

    <Grid Margin="6">
        <Grid.Effect>
            <DropShadowEffect BlurRadius="15" ShadowDepth="0" Opacity="0.5"/>
        </Grid.Effect>
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <!-- 标题栏 -->
            <RowDefinition Height="*"/>
            <!-- 主内容区 -->
            <RowDefinition Height="Auto"/>
            <!-- 通知栏 -->
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" Background="{DynamicResource ColorBorder}"
                CornerRadius="7,7,0,0"
                BorderBrush="{DynamicResource ColorTextMuted}" BorderThickness="0,0,0,1"
                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <TextBlock Text="PCSM Next" FontSize="14" FontWeight="Bold"
                           Foreground="{DynamicResource ColorTextWhite}"
                           VerticalAlignment="Center" Margin="16,0,0,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,8,0">
                    <Button Content="—" Width="36" Height="28" Background="Transparent"
                            Foreground="{DynamicResource ColorTextWhite}" BorderThickness="0"
                            Click="Minimize_Click"/>
                    <Button Content="□" Width="36" Height="28" Background="Transparent"
                            Foreground="{DynamicResource ColorAccent2}" BorderThickness="0"
                            Click="Maximize_Click"/>
                    <Button Content="×" Width="36" Height="28" Background="Transparent"
                            Foreground="{DynamicResource ColorDanger}" BorderThickness="0"
                            Click="Close_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主内容区 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <!-- 左侧导航 -->
                <ColumnDefinition Width="*"/>
                <!-- 右侧内容 -->
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 左侧导航栏 -->
                <Border Grid.Row="0" Background="{DynamicResource ColorSidebar}"
        CornerRadius="0,0,0,7"
        BorderBrush="{DynamicResource ColorBg}" BorderThickness="0,0,1,0">
                    <StackPanel x:Name="NavPanel">
                        <Button x:Name="BtnServers" Content="🖥  服务器" Style="{DynamicResource NavButton}"
                Click="NavButton_Click" Tag="Servers"/>
                        <Button x:Name="BtnJava" Content="☕ Java 管理" Style="{DynamicResource NavButton}"
                Click="NavButton_Click" Tag="Java"/>
                        <Button x:Name="BtnConsole" Content="📋 控制台" Style="{DynamicResource NavButton}"
                Click="NavButton_Click" Tag="Console"/>
                        <Button x:Name="BtnSettings" Content="⚙ 设置" Style="{DynamicResource NavButton}"
                Click="NavButton_Click" Tag="Settings"/>
                        <Button x:Name="BtnAbout" Content="ℹ 关于" Style="{DynamicResource NavButton}"
                Click="NavButton_Click" Tag="About"/>
                    </StackPanel>
                </Border>


                <!-- 通知栏 -->
                <Border Grid.Row="2" Grid.Column="1" x:Name="HintBar" Background="{DynamicResource ColorHint}"
                        BorderBrush="{DynamicResource ColorBorder}" BorderThickness="0,1,0,0"
                        Height="35" VerticalAlignment="Bottom"
                        CornerRadius="0,0,0,7"
                        Visibility="Collapsed" Padding="12,6">
                    <TextBlock x:Name="HintText" Foreground="{DynamicResource ColorTextBlack}" FontSize="13" 
                               Text="Text" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>

            <!-- 右侧内容区 -->
            <Border Grid.Column="1" x:Name="ContentArea"
                    CornerRadius="0,0,7,0"
                    Background="{DynamicResource ColorBg}">
                <!-- 页面在此动态切换 -->
            </Border>
        </Grid>
    </Grid>
</Window>